# WildApricot admin: Settings > Integration > Authorized applications.
# Only the API key is needed. The client ID and secret are for "log in with WildApricot" apps,
# which this isn't, so they're optional here and not used by the server.
WA_API_KEY=paste_your_api_key_here
WA_CLIENT_ID=
WA_CLIENT_SECRET=

# The number at the end of the event's admin URL, e.g. .../admin/events/details/?eventId=1234567
WA_EVENT_ID=1234567

# Optional: if set, attendees must enter this code (post it at the venue door) before
# they can search names. Recommended if the page is reachable from the internet.
CHECKIN_CODE=

# Password volunteers enter on the /desk page (required for the desk page to work).
DESK_PASSWORD=

# Optional: Sched API key (Sched admin > Settings > API). Enables Sched status, invites,
# and schedules on the desk page, and scripts/sched-sync.js.
SCHED_API_KEY=

PORT=3000
